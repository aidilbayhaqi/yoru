APP_ENV=local
APP_NAME=Yoru
APP_VERSION=1.0.0
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

STOREFRONT_URL=http://localhost:3000
CONSOLE_URL=http://localhost:3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

POSTGRES_DB=yoru
POSTGRES_USER=yoru
POSTGRES_PASSWORD=yoru_local_only
DATABASE_URL=postgresql+asyncpg://yoru:yoru_local_only@localhost:5432/yoru
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
TRUSTED_HOSTS=localhost,127.0.0.1,api
REQUEST_TIMEOUT_SECONDS=30
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_RATE_LIMIT_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
COOKIE_SECURE=false
COOKIE_DOMAIN=

SESSION_SIGNING_KEY=local-development-key-change-before-production
REFRESH_TOKEN_PEPPER=local-development-pepper-change-before-production

FEATURE_CUSTOMER_AI=true
FEATURE_PARTNER_COPILOT=true
FEATURE_LIVE_TRACKING=false
FEATURE_DENTAL_SERVICE=false

# Payment providers
PAYMENT_ENABLED_PROVIDERS=mock
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SNAP_BASE_URL=
MIDTRANS_ENABLED_PAYMENTS=qris,gopay,bank_transfer
MIDTRANS_FINISH_REDIRECT_URL=
MIDTRANS_ERROR_REDIRECT_URL=
MAX_REQUEST_BODY_BYTES=10485760
PAYMENT_WEBHOOK_SECRET=local-payment-webhook-secret-change-before-production
METRICS_ENABLED=true
METRICS_TOKEN=
